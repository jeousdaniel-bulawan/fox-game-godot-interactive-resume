[sub_resource type="GDScript" id="GDScript_lbiqa"]
script/source = "extends Label

func _ready():
	await get_tree().process_frame
	update_text()

func _process(_delta):
	update_text()

func update_text():
	if is_instance_valid(Game):
		text = \"Gold: \" + str(Game.Gold)
	else:
		text = \"Gold: 0\"
"

